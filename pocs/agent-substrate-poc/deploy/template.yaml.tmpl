metadata:
  atespace: ate-poc-agents
  name: memory-agent
workerSelector:
  matchLabels:
    workload: memory-agent
containers:
- name: agent
  image: ${AGENT_IMAGE}
  env:
  - name: JOURNAL_PATH
    value: /data/journal.log
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /data
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 268435456
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
- name: data
  durableDir: {}
