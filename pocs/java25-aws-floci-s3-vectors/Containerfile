FROM maven:3.9.12-amazoncorretto-25-alpine AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -q -DskipTests dependency:go-offline
COPY src src
RUN mvn -q package
FROM amazoncorretto:25-alpine
WORKDIR /app
COPY --from=build /workspace/target/java25-floci-s3-vectors-1.0.0.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java","-jar","app.jar"]
