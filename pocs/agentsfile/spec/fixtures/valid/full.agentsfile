# Profiles that cover every block kind, written inline and by reference
version = "1"

profile "dev" {
  description = "Everyday coding setup"

  skill "code-review" {
    description = "Reviews the current diff"
    content     = <<EOT
      # Code review
      Read the diff and list bugs first.

      Then list style issues.
      EOT

    file "scripts/diff.sh" {
      content = <<SH
        #!/usr/bin/env bash
        git diff --stat
      SH
    }

    file "checklist.md" {
      source = "./skills/code-review/checklist.md"
    }
  }

  skill "release-notes" {
    source = "https://github.com/acme/skills/release-notes"
  }

  agent "tester" {
    description = "Writes and runs tests"
    model       = "claude-sonnet-5-5"
    tools       = ["Read", "Grep", "Bash",]
    content     = <<PROMPT
    You write tests first.
      Keep each test small.
    PROMPT
  }

  command "ship" {
    description   = "Runs tests and opens a PR"
    argument-hint = "<branch>"
    model         = "claude-haiku-5-5"
    tools         = ["Bash"]
    content       = <<MD
      Run the tests, then open a PR for $ARGUMENTS.
    MD
  }

  mcp "github" {
    transport = "stdio"
    command   = "npx"
    args      = ["-y", "@modelcontextprotocol/server-github"]
    env       = {
      GITHUB_TOKEN = "${GITHUB_TOKEN}"
      LOG_LEVEL    = "info",
    }
  }
}

profile "ci" {
  agent "reviewer" {
    source      = "./agents/reviewer.md"
    description = "Says \"no\" to\tsloppy code"
  }

  command "fix" {
    source = "./commands/fix.md"
  }

  mcp "docs" {
    transport = "http"
    url       = "https://mcp.acme.dev/docs"
    headers   = { Authorization = "Bearer ${DOCS_TOKEN}" }
  }

  mcp "events" {
    transport = "sse"
    url       = "https://mcp.acme.dev/events"
  }

  mcp "shared" {
    source = "./mcp/shared.json"
  }

  plugin "toolkit" {
    version     = "1.2.0"
    description = "Shared team tooling"
    author      = "Platform team"

    skill "lint" {
      content = "Run the linter and fix every error."
    }

    agent "fixer" {
      source = "./agents/fixer.md"
    }

    command "fix" {
      source = "./commands/fix.md"
    }

    mcp "search" {
      transport = "http"
      url       = "https://mcp.acme.dev/search"
    }
  }

  plugin "security" {
    source = "https://github.com/acme/plugins/security"
  }
}
