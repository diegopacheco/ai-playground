{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "tools", "vite.config.ts"]
}
